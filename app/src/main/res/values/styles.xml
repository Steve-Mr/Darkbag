<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Edge-to-edge is handled in MainActivity.kt -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Expressive Button Style -->
    <style name="Widget.App.Button.Expressive" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_large</item>
        <item name="android:paddingVertical">@dimen/spacing_medium</item>
        <item name="android:paddingHorizontal">@dimen/spacing_large</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
    </style>

    <!-- Large Expressive Icon Button -->
    <style name="Widget.App.Button.IconButton.Large" parent="Widget.Material3.Button.IconButton">
        <item name="iconSize">32dp</item>
    </style>

    <!-- Control Container Card -->
    <style name="Widget.App.Card.ControlPanel" parent="Widget.Material3.CardView.Filled">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.DynamicColors.Dark</item>
        <item name="cardCornerRadius">@dimen/radius_xlarge</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Connected Button Group Style -->
    <style name="Widget.App.MaterialButtonGroup.Connected" parent="Widget.Material3.MaterialButtonGroup.Connected">
        <!-- Any custom overrides if needed -->
    </style>

    <style name="Widget.App.Button.OutlinedButton.Connected" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="Widget.App.Button.Lens" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <!-- 7-sided Cookie Shape -->
    <style name="ShapeAppearance.App.Cookie7" parent="ShapeAppearance.Material3.MediumComponent">
        <!-- We will handle the complex 7-sided path in code or via a custom drawable as ShapeAppearance primarily supports 4 corners -->
    </style>

    <style name="Widget.App.MaterialSwitch.TopBar" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minWidth">100dp</item>
        <item name="android:minHeight">@dimen/round_button_medium</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:switchMinWidth">100dp</item>
    </style>

    <!-- Pill shaped LUT Switcher -->
    <style name="ShapeAppearance.App.LutSwitcher" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="TextAppearance.App.ExpressiveValue" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/vibrant_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.App.ExpressiveLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>


    <style name="ThemeOverlay.App.VibrantIsland" parent="">
        <item name="colorPrimary">@color/vibrant_orange</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/vibrant_orange</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>
        <item name="colorSecondary">@color/vibrant_pink</item>
        <item name="colorTertiary">@color/vibrant_blue</item>
        <item name="colorSurfaceContainer">#222222</item>
    </style>
</resources>
