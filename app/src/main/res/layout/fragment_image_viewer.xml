<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/image_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@android:color/white"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/black_transparent_50"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_share"
            app:iconTint="?attr/colorOnSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_edit"
            app:iconTint="?attr/colorOnSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Edit Controls (Overlay) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_controls_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Selection Overlay for Half-frame -->
        <View
            android:id="@+id/hf_selection_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:background="#00000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/hf_selection_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/hf_selection_divider" />

        <View
            android:id="@+id/hf_selection_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:background="#00000000"
            app:layout_constraintTop_toTopOf="@id/hf_selection_divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/hf_selection_divider"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/hf_selection_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- Top Bar for Log/Lut -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/edit_top_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_log_lut"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:text="Log: None / LUT: None"
                    android:textAllCaps="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:icon="@drawable/ic_lut" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_timestamp"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_photo"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_flare"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_hdr_dynamic"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Basic Adjustments FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_adjust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:contentDescription="Adjust"
            app:srcCompat="@drawable/ic_edit"
            app:layout_constraintBottom_toTopOf="@id/edit_bottom_controls"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Controls for Edit Mode -->
        <LinearLayout
            android:id="@+id/edit_bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black_transparent_50"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@android:color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Split Button Emulation -->
            <LinearLayout
                android:id="@+id/layout_save_split"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_save_main"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SplitButton.Main" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_save_alt"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:padding="0dp"
                    app:icon="@drawable/ic_back"
                    android:rotation="-90"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SplitButton.Alt" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LUT Selection List Overlay (Same as Camera) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/edit_lut_list_container"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/radius_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_top_card"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="400dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/edit_lut_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
