<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/image_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Half-frame Selection Overlays (Used for dimming in edit mode) -->
    <View
        android:id="@+id/hf_selection_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#88000000"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toStartOf="@id/image_pager"
        app:layout_constraintEnd_toStartOf="@+id/hf_selection_divider" />

    <View
        android:id="@+id/hf_selection_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#88000000"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toEndOf="@+id/hf_selection_divider"
        app:layout_constraintEnd_toEndOf="@id/image_pager" />

    <View
        android:id="@+id/hf_selection_divider"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toStartOf="@id/image_pager"
        app:layout_constraintEnd_toEndOf="@id/image_pager" />

    <!-- Full-screen touch overlay for dismissing menus -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent" />

    <!-- Top Bento Header Bar -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceContainerHigh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gallery_pill"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="▦ 01 / 01"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_grid_view"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnErrorContainer"
            app:backgroundTint="?attr/colorErrorContainer" />

        <!-- Top Right: Split Action Button -->
        <com.google.android.material.button.MaterialSplitButton
            android:id="@+id/split_action"
            android:layout_width="wrap_content"
            android:layout_height="42dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_main"
                style="?attr/materialSplitButtonIconFilledTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/share_button_alt"
                app:icon="@drawable/ic_share"
                app:iconTint="?attr/colorOnPrimaryContainer"
                app:backgroundTint="?attr/colorPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_menu"
                style="?attr/materialSplitButtonIconFilledTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:checkable="true"
                android:contentDescription="@string/action_export_options"
                app:icon="@drawable/ic_expand_more_22px"
                app:iconTint="?attr/colorOnPrimaryContainer"
                app:backgroundTint="?attr/colorPrimaryContainer" />
        </com.google.android.material.button.MaterialSplitButton>
    </LinearLayout>

    <!-- Bottom Modular Bento Deck -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/viewer_bento_deck"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="26dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:contentPadding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Contextual Row: Half-Frame Controls -->
            <LinearLayout
                android:id="@+id/hf_extra_controls"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_timestamp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    android:text="DATE\nOFF"
                    android:textSize="10sp"
                    android:lines="2"
                    android:gravity="center"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_time_stamp"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_flare"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    android:text="FLARE\nOFF"
                    android:textSize="10sp"
                    android:lines="2"
                    android:gravity="center"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_flare_none"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_swap"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    android:text="⇄ SWAP\nF1 / F2"
                    android:textSize="10sp"
                    android:lines="2"
                    android:gravity="center"
                    app:cornerRadius="14dp"
                    app:iconSize="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_separate_dng"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    android:text="SPLIT ↗\n独立导出"
                    android:textSize="10sp"
                    android:lines="2"
                    android:gravity="center"
                    app:cornerRadius="18dp"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh" />
            </LinearLayout>

            <!-- Primary Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_log_curve"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="4dp"
                    android:text="LOG CURVE\nNone"
                    android:lines="2"
                    android:gravity="center"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="?attr/colorTertiaryContainer"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_3d_lut"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.35"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="4dp"
                    android:text="3D LUT (.CUBE)\nNone"
                    android:lines="2"
                    android:gravity="center"
                    android:textSize="11sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="?attr/colorTertiaryContainer"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_adjust_tofu"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="4dp"
                    android:text="✦ ADJUST\n豆腐块调色台"
                    android:lines="2"
                    android:gravity="center"
                    android:textSize="11sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Integrated Adjustment Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_adjustment_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/adjustment_island"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/edit_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabMode="fixed"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.tabs.TabItem android:text="Light" />
                    <com.google.android.material.tabs.TabItem android:text="Range" />
                    <com.google.android.material.tabs.TabItem android:text="Tone" />
                    <com.google.android.material.tabs.TabItem android:text="Color" />
                </com.google.android.material.tabs.TabLayout>

                <LinearLayout
                    android:id="@+id/slider_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/edit_tabs">

                    <LinearLayout
                        android:id="@+id/layout_slider_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_label_1"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Exposure"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />
                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/tv_value_1"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0.00"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_slider_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_label_2"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Contrast"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />
                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/tv_value_2"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0.00"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/edit_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/slider_container">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_cancel"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Frame Selector for Half-frame mode -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/group_frame_selection_integrated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:layout_constraintStart_toEndOf="@id/btn_edit_cancel"
                        app:layout_constraintEnd_toStartOf="@id/btn_edit_done"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_frame1_integrated"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F1" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_frame2_integrated"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F2" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_done"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Done"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Full-screen touch interceptor during saving -->
    <View
        android:id="@+id/interaction_blocker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="9dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/initial_loading_indicator"
        style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:elevation="10dp"
        app:indicatorSize="48dp"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toStartOf="@id/image_pager"
        app:layout_constraintEnd_toEndOf="@id/image_pager" />

    <!-- LUT Selection List Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lut_list_container"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/radius_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/viewer_bento_deck"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="400dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lut_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Gallery Grid Mode Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gallery_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainerLowest"
        android:visibility="gone"
        android:elevation="15dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/gallery_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/gallery_title"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gallery_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="2dp"
            app:layout_constraintTop_toBottomOf="@id/gallery_toolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Action Bar (Shown in selection mode) -->
        <LinearLayout
            android:id="@+id/gallery_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:background="?attr/colorSurfaceContainer"
            android:elevation="6dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gallery_delete"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playground_btn_delete"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorOnErrorContainer"
                app:backgroundTint="?attr/colorErrorContainer"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
