<?xml version="1.0" encoding="utf-8"?>
<!--
  ZSL capability probe sheet (design §3.12.4). Skeleton mirrors bottom_sheet_bento_selection.xml:
  drag handle + title row (title + status badge) + NestedScrollView body.
  All copy resolves through @string/; no android:text literals.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Header Row: title + probe status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tv_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="ZSL capability test"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_sheet_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bento_badge_tertiary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            tools:text="RUNNING"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTertiary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Progress / verdict line: zsl_probe_progress(%1$s) while running. -->
            <TextView
                android:id="@+id/txt_zsl_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Testing Baseline" />

            <!-- 6 metric rows inflated from item_zsl_metric_row.xml. -->
            <LinearLayout
                android:id="@+id/container_zsl_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- Action row: primary (Run/Cancel/Retest/Done) + secondary (Details/Done/Copy). -->
            <top.maary.darkbag.ui.bento.BentoRowLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_zsl_primary"
                    style="@style/Widget.Darkbag.BentoTile.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="?attr/colorSurface"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp"
                    tools:text="Retest" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_zsl_secondary"
                    style="@style/Widget.Darkbag.BentoTile.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="?attr/colorSurface"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp"
                    tools:text="Copy report" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_zsl_tertiary"
                    style="@style/Widget.Darkbag.BentoTile.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="?attr/colorSurface"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp"
                    tools:text="Done" />
            </top.maary.darkbag.ui.bento.BentoRowLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
