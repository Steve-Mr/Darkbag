<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjustments"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:layout_marginBottom="16dp" />

    <include
        android:id="@+id/adjust_exposure"
        layout="@layout/view_adjustment_slider" />

    <include
        android:id="@+id/adjust_contrast"
        layout="@layout/view_adjustment_slider" />

    <include
        android:id="@+id/adjust_highlights"
        layout="@layout/view_adjustment_slider" />

    <include
        android:id="@+id/adjust_shadows"
        layout="@layout/view_adjustment_slider" />

    <include
        android:id="@+id/adjust_whites"
        layout="@layout/view_adjustment_slider" />

    <include
        android:id="@+id/adjust_blacks"
        layout="@layout/view_adjustment_slider" />

    <include
        android:id="@+id/adjust_saturation"
        layout="@layout/view_adjustment_slider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Curve"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/log_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

</LinearLayout>
