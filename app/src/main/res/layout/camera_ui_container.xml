<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <!-- Transparent Touch Overlay for dismissing menus -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Top Left Controls (HDR+ Pill) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hdr_plus_pill"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/margin_medium"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="@id/top_right_controls"
        app:layout_constraintBottom_toBottomOf="@id/top_right_controls"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tv_hdr_status"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="OFF"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginEnd="4dp"
                android:textColor="?attr/colorOnSecondaryContainer"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hdr_plus_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/top_right_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginEnd="@dimen/margin_medium"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flash_button"
            style="@style/Widget.App.Button.IconButton.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            app:icon="@drawable/ic_flash_off"
            app:iconTint="?attr/colorOnSecondaryContainer"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:contentDescription="@string/toggle_flash"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/motion_photo_button"
            style="@style/Widget.App.Button.IconButton.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            app:icon="@drawable/ic_motion_photo_off"
            app:iconTint="?attr/colorOnSecondaryContainer"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:contentDescription="@string/toggle_motion_photo"
            android:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            style="@style/Widget.App.Button.IconButton.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_settings"
            app:iconTint="?attr/colorOnTertiaryContainer"
            android:backgroundTint="?attr/colorTertiaryContainer"
            android:contentDescription="@string/settings_button_alt" />
    </LinearLayout>

    <!-- Recording Status Indicator Capsule (Top Center) -->
    <LinearLayout
        android:id="@+id/recording_indicator_capsule"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_multi_camera_capsule"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/top_right_controls"
        app:layout_constraintBottom_toBottomOf="@id/top_right_controls"
        app:layout_constraintStart_toEndOf="@id/hdr_plus_pill"
        app:layout_constraintEnd_toStartOf="@id/top_right_controls">

        <View
            android:id="@+id/rec_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rec_dot" />

        <TextView
            android:id="@+id/tv_rec_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REC 00:00"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

    </LinearLayout>


    <!-- Level 1: Pro Mode Trigger Button (Top-Left of Viewfinder) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pro_mode"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:minWidth="44dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="0dp"
        android:minHeight="0dp"
        android:text="PRO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:cornerRadius="18dp"
        app:strokeWidth="1dp"
        app:strokeColor="#4DFFFFFF"
        android:backgroundTint="#731C1B1F"
        app:elevation="2dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/viewFinderContainer"
        app:layout_constraintStart_toStartOf="@id/viewFinderContainer" />

    <!-- Level 2: Pro Parameter Connected Button Group (M3 Expressive Connected Capsule) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pro_info_bar_card"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:cornerRadius="18dp"
        app:elevation="2dp"
        android:background="@drawable/bg_pro_connected_group"
        app:layout_constraintTop_toTopOf="@id/btn_pro_mode"
        app:layout_constraintBottom_toBottomOf="@id/btn_pro_mode"
        app:layout_constraintStart_toEndOf="@id/btn_pro_mode"
        app:layout_constraintEnd_toEndOf="@id/viewFinderContainer">

        <!-- Focus Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pill_focus"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="AF"
            android:textColor="?attr/colorOnSurface"
            app:strokeWidth="0.5dp"
            app:strokeColor="?attr/colorOutlineVariant" />

        <!-- ISO Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pill_iso"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="ISO"
            android:textColor="?attr/colorOnSurface"
            app:strokeWidth="0.5dp"
            app:strokeColor="?attr/colorOutlineVariant" />

        <!-- Shutter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pill_shutter"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="SEC"
            android:textColor="?attr/colorOnSurface"
            app:strokeWidth="0.5dp"
            app:strokeColor="?attr/colorOutlineVariant" />

        <!-- EV Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pill_ev"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="EV"
            android:textColor="?attr/colorOnSurface"
            app:strokeWidth="0.5dp"
            app:strokeColor="?attr/colorOutlineVariant" />

        <!-- Multi-Camera Sync Link Button (Visible in Multi-Camera mode) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pro_link"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:icon="@drawable/ic_link"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurface"
            app:strokeWidth="0.5dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:visibility="gone"
            android:contentDescription="Toggle Multi-Camera Sync Link" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Level 3: Pro Dial Wheel Top Panel (Integrated directly below Level 2 bar) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/manual_controls_root"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#8C1C1B1F"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintTop_toBottomOf="@id/btn_pro_mode"
        app:layout_constraintStart_toStartOf="@id/viewFinderContainer"
        app:layout_constraintEnd_toEndOf="@id/viewFinderContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Dial Control Container -->
            <LinearLayout
                android:id="@+id/dial_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Dial Top Control Bar: Active Target Name, Value, Auto Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_dial_target_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHUTTER"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#FFD54F" />

                    <TextView
                        android:id="@+id/tv_dial_target_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:layout_marginStart="8dp"
                        android:text="1/125s"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@android:color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dial_auto"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="AUTO"
                        android:textColor="@android:color/white"
                        app:cornerRadius="16dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#33FFFFFF"
                        android:backgroundTint="#40FFFFFF" />
                </LinearLayout>

                <!-- Professional Dial Wheel -->
                <top.maary.darkbag.ui.ProDialWheelView
                    android:id="@+id/dial_wheel_view"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp" />

                <!-- Focus Specific Shortcuts -->
                <LinearLayout
                    android:id="@+id/focus_extras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:paddingTop="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_focus_near"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        android:text="Macro"
                        app:cornerRadius="15dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_focus_far"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        android:text="Infinity"
                        app:cornerRadius="15dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Control Island -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_island_card"
        style="@style/Widget.App.Card.ControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:alpha="0.9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/padding_small"
            android:paddingHorizontal="@dimen/padding_large">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/shutter_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- LUT Switcher Strip -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lut_switcher_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.LutSwitcher"
                app:backgroundTint="?attr/colorSurfaceContainerHighest"
                android:text="None"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:gravity="start|center_vertical"
                android:paddingStart="32dp"
                app:layout_constraintEnd_toEndOf="@id/shutter_center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/camera_capture_button"
                app:layout_constraintBottom_toBottomOf="@id/camera_capture_button"
                android:layout_marginEnd="20dp" />

            <top.maary.darkbag.ui.ExpressiveShutterButton
                android:id="@+id/camera_capture_button"
                android:layout_width="@dimen/shutter_button_size"
                android:layout_height="@dimen/shutter_button_size"
                android:contentDescription="@string/capture_button_alt"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Half-frame Progress Indicator -->
            <TextView
                android:id="@+id/tv_half_frame_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="1/2"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/camera_capture_button"
                app:layout_constraintBottom_toBottomOf="@id/camera_capture_button"
                app:layout_constraintStart_toStartOf="@id/camera_capture_button"
                app:layout_constraintEnd_toEndOf="@id/camera_capture_button" />

            <FrameLayout
                android:id="@+id/photo_view_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/camera_capture_button"
                app:layout_constraintBottom_toBottomOf="@id/camera_capture_button">

                <ImageButton
                    android:id="@+id/photo_view_button"
                    android:layout_width="@dimen/round_button_medium"
                    android:layout_height="@dimen/round_button_medium"
                    android:padding="@dimen/spacing_medium"
                    android:scaleType="fitCenter"
                    android:background="@drawable/ic_outer_circle"
                    android:src="@drawable/ic_photo"
                    android:contentDescription="@string/gallery_button_alt" />

                <com.google.android.material.loadingindicator.LoadingIndicator
                    android:id="@+id/processing_progress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- LUT List Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lut_list_container"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/radius_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_island_card"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="400dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lut_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>


</merge>
