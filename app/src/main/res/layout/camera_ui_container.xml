<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <!-- Transparent Touch Overlay for dismissing active manual dial wheel when tapping viewfinder -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_island_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Safe-Area Anchor (Zero visual clutter at top of screen) -->
    <Space
        android:id="@+id/top_right_controls"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Legacy hidden Pro trigger button (superseded by btn_bento_tier) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pro_mode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ========================================================================= -->
    <!-- MODULAR DARKROOM BENTO MATRIX DECK (All controls in the lower thumb zone) -->
    <!-- ========================================================================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_island_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="26dp"
        app:contentPadding="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <top.maary.darkbag.ui.CameraBentoDeckView
            android:id="@+id/bento_deck_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ================================================================= -->
            <!-- ROW A: PRO TELEMETRY & THUMB DIAL MODULE (Visible ONLY in PRO)    -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/bento_pro_module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Sub-Row A1: Thumb-Zone Pro Dial Wheel Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/manual_controls_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:id="@+id/dial_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_dial_target_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ISO"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_dial_target_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical"
                                android:layout_marginStart="8dp"
                                android:text="AUTO"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurface" />

                            <!-- Focus Specific Shortcuts inline in header -->
                            <LinearLayout
                                android:id="@+id/focus_extras"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginEnd="6dp"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_focus_near"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:layout_marginEnd="4dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingHorizontal="8dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:textSize="10.5sp"
                                    android:text="Macro"
                                    app:cornerRadius="10dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_focus_far"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingHorizontal="8dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:textSize="10.5sp"
                                    android:text="∞"
                                    app:cornerRadius="10dp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_dial_auto"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="10dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:text="AUTO"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <top.maary.darkbag.ui.ProDialWheelView
                            android:id="@+id/dial_wheel_view"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sub-Row A2: Pro Telemetry & Parameter Bento Row (AF/MF · ISO · SEC · EV · LINK) -->
                <LinearLayout
                    android:id="@+id/pro_info_bar_card"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    android:background="@drawable/bg_pro_connected_group">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pill_focus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="1dp"
                        android:paddingVertical="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:maxLines="2"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:text="AF"
                        android:textColor="?attr/colorOnSurface"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="?attr/colorOutlineVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pill_iso"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="1dp"
                        android:paddingVertical="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:maxLines="2"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:text="ISO"
                        android:textColor="?attr/colorOnSurface"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="?attr/colorOutlineVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pill_shutter"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="1dp"
                        android:paddingVertical="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:maxLines="2"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:text="SEC"
                        android:textColor="?attr/colorOnSurface"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="?attr/colorOutlineVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pill_ev"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="1dp"
                        android:paddingVertical="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:maxLines="2"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:text="EV"
                        android:textColor="?attr/colorOnSurface"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="?attr/colorOutlineVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pro_link"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="38dp"
                        android:layout_height="match_parent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:icon="@drawable/ic_link"
                        app:iconSize="18dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnSurface"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        android:visibility="gone"
                        android:contentDescription="Toggle Multi-Camera Sync Link" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- ROW B: COLOR RECIPE (LOG + LUT) & QUICK SWITCHES (FILM & PRO)     -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/bento_film_row"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible">

                <!-- 1. Base Log Bento Cell (Best-effort width + single-line truncation) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bento_log_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.95"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="false"
                    android:text="Log: Off"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="start|center_vertical"
                    app:cornerRadius="14dp"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:textColor="?attr/colorOnSurface" />

                <!-- 2. 3D LUT Bento Cell (Best-effort width + single-line truncation) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lut_switcher_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.55"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="false"
                    android:text="None"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="start|center_vertical"
                    app:icon="@drawable/ic_lut"
                    app:iconSize="16dp"
                    app:iconPadding="5dp"
                    app:iconTint="?attr/colorPrimary"
                    app:cornerRadius="14dp"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:textColor="?attr/colorOnSurface" />

                <!-- 3. HDR+ Bento Tile -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hdr_plus_pill"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tv_hdr_status"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="HDR+"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/hdr_plus_switch"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Underexposure (DYN) / Flash Bento Tile (Uses existing icons!) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/flash_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_hdr_dynamic"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSecondaryContainer"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    app:cornerRadius="14dp"
                    android:contentDescription="@string/toggle_flash"
                    android:visibility="visible" />

                <!-- 5. Motion Photo (LIVE) Bento Tile (Uses existing icons!) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/motion_photo_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_motion_photo_off"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    app:cornerRadius="14dp"
                    android:contentDescription="@string/toggle_motion_photo"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- ROW C: OPTICS & SHOOTING MODE BENTO ROW (Always in Thumb Zone!)   -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/lens_control_row"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible">

                <!-- 1. Leading Bento Tile: Capture Mode Switcher (Normal / Half-SBS / Half-TB / Multi-Cam) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_switch_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_mode_normal"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHighest"
                    app:cornerRadius="18dp"
                    android:contentDescription="Switch Capture Mode" />

                <!-- 2. Center Dynamic Weighted Lens Bento Strip (Physical vs Crop Lenses) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lens_controls_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/lens_controls_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Trailing Bento Tile: Camera Front/Back Flip (or Front PiP in Multi-Cam) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/camera_switch_button_alt"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_switch"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    app:cornerRadius="18dp"
                    android:contentDescription="@string/switch_camera_button_alt" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- ROW D: PRIMARY SHUTTER DOCK (Gallery + Tofu Shutter + P&S/FILM/PRO) -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/bento_shutter_row"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 1. Left Bento Tile: Gallery Thumbnail & Processing Indicator -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/photo_view_card"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <FrameLayout
                        android:id="@+id/photo_view_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageButton
                            android:id="@+id/photo_view_button"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:padding="0dp"
                            android:scaleType="centerCrop"
                            android:background="@null"
                            android:src="@drawable/ic_photo"
                            android:contentDescription="@string/gallery_button_alt" />

                        <com.google.android.material.loadingindicator.LoadingIndicator
                            android:id="@+id/processing_progress"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Center Bento Tile: The Bento "Tofu Block" (豆腐块) Shutter -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp">

                    <top.maary.darkbag.ui.ExpressiveShutterButton
                        android:id="@+id/camera_capture_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/capture_button_alt" />

                    <!-- Kept gone for legacy reference compatibility; Tofu Shutter renders Left/Right split directly -->
                    <TextView
                        android:id="@+id/tv_half_frame_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:text="1/2" />
                </FrameLayout>

                <!-- 3. Right Bento Stack: P&S / FILM / PRO Tier Button + Playground / Settings -->
                <LinearLayout
                    android:layout_width="102dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bento_tier"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="FILM"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:backgroundTint="?attr/colorSecondaryContainer"
                        android:textColor="?attr/colorOnSecondaryContainer" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_bento_playground"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_style"
                            app:iconSize="18dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="?attr/colorOnSurfaceVariant"
                            app:backgroundTint="?attr/colorSurfaceContainerHigh"
                            app:cornerRadius="12dp"
                            android:contentDescription="Color Playground" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settings_button"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_settings"
                            app:iconSize="18dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="?attr/colorOnSurfaceVariant"
                            app:backgroundTint="?attr/colorSurfaceContainerHigh"
                            app:cornerRadius="12dp"
                            android:contentDescription="@string/settings_button_alt" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

