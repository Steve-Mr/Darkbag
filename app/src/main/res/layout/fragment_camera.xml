<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/view_finder_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/view_finder_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:cardCornerRadius="@dimen/radius_xlarge"
        app:cardBackgroundColor="@android:color/black"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/view_finder_bottom_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/margin_small">

        <com.android.example.cameraxbasic.utils.AutoFitTextureView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/focus_ring"
        android:layout_width="@dimen/focus_ring_size"
        android:layout_height="@dimen/focus_ring_size"
        android:background="@drawable/ic_focus_ring"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/view_finder_container"
        app:layout_constraintStart_toStartOf="@id/view_finder_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
