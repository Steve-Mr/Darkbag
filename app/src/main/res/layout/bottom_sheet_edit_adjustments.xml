<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/edit_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Light" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color" />
        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_effects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Effects" />
    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Light Tab Content -->
            <LinearLayout
                android:id="@+id/layout_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exposure" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_exposure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-3.0"
                    android:valueTo="3.0"
                    android:value="0.0" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contrast" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_contrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-1.0"
                    android:valueTo="1.0"
                    android:value="0.0" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Highlights" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_highlights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-1.0"
                    android:valueTo="1.0"
                    android:value="0.0" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shadows" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_shadows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-1.0"
                    android:valueTo="1.0"
                    android:value="0.0" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Whites" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_whites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-1.0"
                    android:valueTo="1.0"
                    android:value="0.0" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Blacks" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_blacks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-1.0"
                    android:valueTo="1.0"
                    android:value="0.0" />
            </LinearLayout>

            <!-- Color Tab Content -->
            <LinearLayout
                android:id="@+id/layout_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saturation" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_saturation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-1.0"
                    android:valueTo="1.0"
                    android:value="0.0" />
            </LinearLayout>

            <!-- Effects Tab Content -->
            <LinearLayout
                android:id="@+id/layout_effects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_timestamp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date Stamp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Light Leak / Flare" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/group_flare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_flare_none"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="None" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_flare_random"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rand" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_flare_v"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Side" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_flare_c"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Corner" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
