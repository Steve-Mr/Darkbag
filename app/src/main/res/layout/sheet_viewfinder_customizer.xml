<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="?attr/colorSurfaceContainer">

    <LinearLayout
        android:id="@+id/layout_customizer_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="36dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_capsule"
            android:backgroundTint="?attr/colorOutlineVariant" />

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/viewfinder_customizer_preview_label"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/viewfinder_customizer_title"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_customizer"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_close"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Live Viewfinder Preview Card (Authentic WYSIWYG Bento Matrix) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_viewfinder_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#121417"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/container_preview_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 1. Top Viewfinder Stage (Zero Top-Bar Clutter) -->
                <FrameLayout
                    android:id="@+id/preview_viewfinder_stage"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/button_round_corners"
                    android:backgroundTint="#16181B"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="[ + ]  4:3"
                        android:textColor="#555E68"
                        android:textSize="9.5sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/preview_focus_peaking_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_badge_capsule"
                        android:backgroundTint="#2E7D32"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="PEAK"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 2. Bottom Bento Matrix Deck Container -->
                <LinearLayout
                    android:id="@+id/preview_bento_deck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/button_round_corners"
                    android:backgroundTint="#1E2024"
                    android:padding="6dp">

                    <!-- ROW A: Pro Telemetry Bar -->
                    <LinearLayout
                        android:id="@+id/preview_pro_module"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="5dp">

                        <TextView
                            android:id="@+id/preview_pill_af"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:gravity="center"
                            android:text="AF\nAUTO"
                            android:textColor="#C5CBD3"
                            android:textSize="7.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_pill_iso"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:gravity="center"
                            android:text="ISO\n100"
                            android:textColor="#C5CBD3"
                            android:textSize="7.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_pill_shutter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:gravity="center"
                            android:text="SEC\n1/125"
                            android:textColor="#C5CBD3"
                            android:textSize="7.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_pill_ev"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:gravity="center"
                            android:text="EV\n+0.0"
                            android:textColor="#C5CBD3"
                            android:textSize="7.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ROW B: Film Recipe & Quick Switches -->
                    <LinearLayout
                        android:id="@+id/preview_film_row"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp">

                        <TextView
                            android:id="@+id/preview_log_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.95"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:gravity="center"
                            android:text="F-Log2"
                            android:textColor="#E0E3E8"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_lut_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.55"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:gravity="center"
                            android:text="Classic Neg"
                            android:textColor="#E0E3E8"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/preview_hdr_plus_pill"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:gravity="center"
                            android:text="HDR+"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/preview_underexposure"
                            android:layout_width="32dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="?attr/colorSecondaryContainer"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_hdr_dynamic"
                            app:tint="?attr/colorOnSecondaryContainer" />

                        <ImageView
                            android:id="@+id/preview_motion_photo_button"
                            android:layout_width="32dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_motion_photo_off"
                            app:tint="#8E939B" />
                    </LinearLayout>

                    <!-- ROW C: Lens Controls -->
                    <LinearLayout
                        android:id="@+id/preview_lens_row"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp">

                        <ImageView
                            android:id="@+id/preview_mode_switch"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_mode_normal"
                            app:tint="#D0D5DD" />

                        <LinearLayout
                            android:id="@+id/preview_lens_controls"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingHorizontal="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.6x"
                                android:textColor="#8E939B"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:background="@drawable/button_round_corners"
                                android:backgroundTint="?attr/colorPrimaryContainer"
                                android:paddingHorizontal="6dp"
                                android:gravity="center"
                                android:text="1x"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="28"
                                android:textColor="#8E939B"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35"
                                android:textColor="#8E939B"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3x"
                                android:textColor="#8E939B"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/preview_camera_switch"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_switch"
                            app:tint="#D0D5DD" />
                    </LinearLayout>

                    <!-- ROW D: Shutter & Utility Row -->
                    <LinearLayout
                        android:id="@+id/preview_shutter_row"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Gallery Thumbnail Preview -->
                        <FrameLayout
                            android:id="@+id/preview_gallery_card"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/button_round_corners"
                            android:backgroundTint="#2B2E34">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_photo"
                                app:tint="#8E939B" />
                        </FrameLayout>

                        <!-- Authentic Tofu Block Shutter Button -->
                        <top.maary.darkbag.ui.ExpressiveShutterButton
                            android:id="@+id/preview_capture_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="6dp"
                            android:clickable="false"
                            android:focusable="false" />

                        <!-- Right Dual-Layer Stack -->
                        <LinearLayout
                            android:id="@+id/preview_right_stack"
                            android:layout_width="72dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/preview_tier_pill"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="@drawable/button_round_corners"
                                android:backgroundTint="?attr/colorPrimaryContainer"
                                android:gravity="center"
                                android:text="CUSTOM"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="8.5sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:layout_marginTop="3dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/preview_playground_button"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/button_round_corners"
                                    android:backgroundTint="#2B2E34"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_style"
                                    app:tint="#D0D5DD" />

                                <ImageView
                                    android:id="@+id/preview_settings_button"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/button_round_corners"
                                    android:backgroundTint="#2B2E34"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_settings"
                                    app:tint="#D0D5DD" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Base Template Initializer Row -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/viewfinder_customizer_template_title"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="6dp" />

        <top.maary.darkbag.ui.bento.BentoRowLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_template_ps"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:text="@string/viewfinder_customizer_template_ps"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_template_film"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:text="@string/viewfinder_customizer_template_film"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_template_pro"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:text="@string/viewfinder_customizer_template_pro"
                android:textSize="11sp" />
        </top.maary.darkbag.ui.bento.BentoRowLayout>

        <!-- Category 1: Basic Viewfinder Controls -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/viewfinder_group_basic"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="6dp" />

        <top.maary.darkbag.ui.bento.BentoRowLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp">

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_lens_controls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_lens_controls" />

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_camera_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_camera_switch" />
        </top.maary.darkbag.ui.bento.BentoRowLayout>

        <top.maary.darkbag.ui.bento.BentoSwitchTile
            android:id="@+id/switch_settings_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            app:bentoSwitchTitle="@string/settings_ui_settings_tile" />

        <!-- Category 2: Film & Computational Photography -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/viewfinder_group_film"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="6dp" />

        <top.maary.darkbag.ui.bento.BentoRowLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp">

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_lut_switcher"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_lut_switcher" />

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_hdr_plus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_hdr_tile" />
        </top.maary.darkbag.ui.bento.BentoRowLayout>

        <top.maary.darkbag.ui.bento.BentoRowLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp">

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_underexposure"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_underexposure_tile" />

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_mode_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_mode_switch_tile" />
        </top.maary.darkbag.ui.bento.BentoRowLayout>

        <!-- Category 3: Pro Manual Controls -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/viewfinder_group_pro"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="6dp" />

        <top.maary.darkbag.ui.bento.BentoRowLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_manual_controls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_manual_controls" />

            <top.maary.darkbag.ui.bento.BentoSwitchTile
                android:id="@+id/switch_focus_peaking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:bentoSwitchTitle="@string/settings_ui_focus_peaking" />
        </top.maary.darkbag.ui.bento.BentoRowLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
