<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_lut_item"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:strokeColor="@android:color/transparent"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <!-- Leading Indicator / Film Recipe Badge Container -->
        <FrameLayout
            android:id="@+id/layout_recipe_icon_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/colorSurfaceContainerHigh">

            <ImageView
                android:id="@+id/iv_recipe_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lut"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Center 2-Line Micro-Telemetry: Title & Interactive Log Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_lut_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classic Neg"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textStyle="bold"
                android:textSize="14.5sp"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Interactive Log Pill Badge: Tap directly to switch association -->
                <TextView
                    android:id="@+id/tv_lut_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2.5dp"
                    android:text="F-Log2 ▾"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:background="?attr/colorPrimaryContainer"
                    android:clickable="true"
                    android:focusable="true"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- Active Recipe Status Badge (shown when active in Camera) -->
                <TextView
                    android:id="@+id/tv_active_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="ACTIVE"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:background="?attr/colorSurfaceContainerHigh"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>

        <!-- Trailing Actions (Compact Bento Icon Buttons) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rename"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_edit"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/lut_rename_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorError"
            android:contentDescription="@string/lut_delete_title" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
