<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/gallery_info_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Two-Column Bento Matrix Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Column: Capture Device Info Card -->
        <top.maary.darkbag.ui.bento.BentoTrayCard
            android:id="@+id/card_device_info"
            style="@style/Widget.Darkbag.BentoTray"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="18dp"
            app:bentoContainerRole="surfaceContainerHigh"
            app:contentPadding="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_info_device"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Model -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gallery_info_model"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_device_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Pixel"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Lens -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gallery_info_lens"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_device_lens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="24mm f/1.7"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Sensor -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gallery_info_sensor"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_device_sensor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="50MP"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </top.maary.darkbag.ui.bento.BentoTrayCard>

        <!-- Right Column: Album Stats Card -->
        <top.maary.darkbag.ui.bento.BentoTrayCard
            android:id="@+id/card_album_stats"
            style="@style/Widget.Darkbag.BentoTray"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="18dp"
            app:bentoContainerRole="surfaceContainerHigh"
            app:contentPadding="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_info_stats"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Total Count -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gallery_info_total_count"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_stat_total_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="0"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Storage Size -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gallery_info_total_size"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_stat_total_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="0 MB"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Last Capture -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/gallery_info_last_capture"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/tv_stat_last_capture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="--"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </top.maary.darkbag.ui.bento.BentoTrayCard>

    </LinearLayout>

</LinearLayout>
