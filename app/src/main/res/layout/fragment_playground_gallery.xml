<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:elevation="0dp"
        app:liftOnScroll="false"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            app:title="Playground"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:menu="@menu/menu_playground_gallery" />

        <top.maary.darkbag.ui.bento.BentoTrayCard
            android:id="@+id/playground_top_bento_card"
            style="@style/Widget.Darkbag.BentoTray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            app:bentoContainerRole="surfaceContainer"
            app:cardElevation="6dp"
            app:contentPadding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_playground_back"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:contentDescription="@string/back_button_alt" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/playground_title_card"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:id="@+id/tv_playground_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/playground_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tv_playground_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="外部暗房 · 0 组"
                            android:textSize="9.5sp"
                            android:textColor="?attr/colorTertiary"
                            android:singleLine="true"
                            android:ellipsize="end" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_playground_select_all"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="56dp"
                    android:layout_marginEnd="6dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/gallery_select_all"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    android:textColor="?attr/colorOnSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_playground_settings"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:contentDescription="@string/settings_title" />

            </LinearLayout>

        </top.maary.darkbag.ui.bento.BentoTrayCard>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="4dp"
        tools:listitem="@layout/item_playground_image" />

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/playground_empty_hint"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- Centered Loading Indicator Capsule (Bento Matrix parity with Darkroom Gallery) -->
    <top.maary.darkbag.ui.bento.BentoTrayCard
        android:id="@+id/playground_loading_indicator"
        style="@style/Widget.Darkbag.BentoTray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardCornerRadius="22dp"
        app:bentoContainerRole="surfaceContainerHigh"
        app:contentPadding="10dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/playground_loading_progress"
                style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorSize="22dp"
                app:trackThickness="3dp"
                app:indicatorColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_playground_loading_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/playground_loading"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </top.maary.darkbag.ui.bento.BentoTrayCard>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:elevation="0dp"
        app:backgroundTint="@android:color/transparent" />

    <!-- Always-Docked Bottom Concentric Bento Action Deck -->
    <top.maary.darkbag.ui.bento.BentoTrayCard
        android:id="@+id/playground_bento_dock"
        style="@style/Widget.Darkbag.BentoTray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        app:cardCornerRadius="26dp"
        app:bentoContainerRole="surfaceContainer"
        app:cardElevation="6dp"
        app:contentPadding="6dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Normal Mode Actions: Select All, Layout Toggle, Import -->
            <LinearLayout
                android:id="@+id/layout_playground_normal_actions"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_playground_dock_select_all"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_select_all"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurface"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/gallery_select_all"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_playground_dock_layout"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_grid_view"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurface"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="2 Cols"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fabAdd"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurface"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/gallery_import"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Selection Mode Actions: Merge, Export, Disband, Delete -->
            <LinearLayout
                android:id="@+id/layout_playground_selection_actions"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMerge"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_mode_half_side"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/playground_btn_merge"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/playground_btn_export"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisband"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="2dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_layers"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconTint="?attr/colorOnSurface"
                    app:backgroundTint="?attr/colorSurfaceContainerHigh"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/playground_btn_disband"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnErrorContainer"
                    app:backgroundTint="?attr/colorErrorContainer" />
            </LinearLayout>
        </FrameLayout>
    </top.maary.darkbag.ui.bento.BentoTrayCard>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
