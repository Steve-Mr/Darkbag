<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/permissions_fragment">

    <fragment
        android:id="@+id/permissions_fragment"
        android:name="top.maary.darkbag.fragments.PermissionsFragment"
        android:label="PermissionsFragment" >
        <action
            android:id="@+id/action_permissions_to_home"
            app:destination="@id/home_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_permissions_to_camera_direct"
            app:destination="@id/camera_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_permissions_to_gallery"
            app:destination="@id/gallery_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/home_fragment"
        android:name="top.maary.darkbag.fragments.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_home_to_camera"
            app:destination="@id/camera_fragment" />
        <action
            android:id="@+id/action_home_to_gallery"
            app:destination="@id/gallery_fragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settings_fragment" />
        <action
            android:id="@+id/action_home_to_image_viewer"
            app:destination="@id/image_viewer_fragment" />
    </fragment>

    <fragment
        android:id="@+id/camera_fragment"
        android:name="top.maary.darkbag.fragments.CameraFragment"
        android:label="CameraFragment" >
        <action
            android:id="@+id/action_camera_to_settings"
            app:destination="@id/settings_fragment" />
        <action
            android:id="@+id/action_camera_to_image_viewer"
            app:destination="@id/image_viewer_fragment" />
    </fragment>

    <fragment
        android:id="@+id/gallery_fragment"
        android:name="top.maary.darkbag.fragments.GalleryFragment"
        android:label="GalleryFragment">
        <action
            android:id="@+id/action_gallery_to_image_viewer"
            app:destination="@id/image_viewer_fragment" />
    </fragment>

    <fragment
        android:id="@+id/image_viewer_fragment"
        android:name="top.maary.darkbag.fragments.ImageViewerFragment"
        android:label="ImageViewerFragment">
        <argument
            android:name="initial_uri"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settings_fragment"
        android:name="top.maary.darkbag.fragments.SettingsFragment"
        android:label="SettingsFragment">
        <action
            android:id="@+id/action_settings_to_lut_management"
            app:destination="@id/lut_management_fragment" />
    </fragment>

    <fragment
        android:id="@+id/lut_management_fragment"
        android:name="top.maary.darkbag.fragments.LutManagementFragment"
        android:label="Manage LUTs" />

</navigation>
