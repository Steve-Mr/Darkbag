<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/permissions_fragment">

    <fragment
        android:id="@+id/permissions_fragment"
        android:name="top.maary.darkbag.fragments.PermissionsFragment"
        android:label="PermissionsFragment" >

        <action
            android:id="@+id/action_permissions_to_camera"
            app:destination="@id/camera_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_permissions_to_gallery"
            app:destination="@id/gallery_fragment"
            app:popUpTo="@id/permissions_fragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/gallery_fragment"
        android:name="top.maary.darkbag.fragments.GalleryFragment"
        android:label="Gallery" >

        <action
            android:id="@+id/action_gallery_fragment_to_camera_fragment"
            app:destination="@id/camera_fragment" />

        <action
            android:id="@+id/action_gallery_fragment_to_full_gallery_fragment"
            app:destination="@id/full_gallery_fragment" />

        <action
            android:id="@+id/action_gallery_fragment_to_settings_fragment"
            app:destination="@id/settings_fragment" />

        <action
            android:id="@+id/action_gallery_fragment_to_edit_fragment"
            app:destination="@id/edit_fragment" />

    </fragment>

    <fragment
        android:id="@+id/full_gallery_fragment"
        android:name="top.maary.darkbag.fragments.FullGalleryFragment"
        android:label="Full Gallery" >
        <argument
            android:name="showImported"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_full_gallery_fragment_to_edit_fragment"
            app:destination="@id/edit_fragment" />
    </fragment>

    <fragment
        android:id="@+id/edit_fragment"
        android:name="top.maary.darkbag.fragments.EditFragment"
        android:label="Edit" >
        <argument
            android:name="imageId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="image1Id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="image2Id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="isNewStitch"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/camera_fragment"
        android:name="top.maary.darkbag.fragments.CameraFragment"
        android:label="CameraFragment" >

        <action
            android:id="@+id/action_camera_to_permissions"
            app:destination="@id/permissions_fragment"
            app:popUpTo="@id/camera_fragment"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/action_camera_to_settings"
            app:destination="@id/settings_fragment" />

        <action
            android:id="@+id/action_camera_to_gallery"
            app:destination="@id/gallery_fragment"
            app:popUpTo="@id/camera_fragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/settings_fragment"
        android:name="top.maary.darkbag.fragments.SettingsFragment"
        android:label="SettingsFragment">

        <action
            android:id="@+id/action_settings_to_lut_management"
            app:destination="@id/lut_management_fragment" />
    </fragment>

    <fragment
        android:id="@+id/lut_management_fragment"
        android:name="top.maary.darkbag.fragments.LutManagementFragment"
        android:label="Manage LUTs" />

</navigation>
