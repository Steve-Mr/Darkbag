<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <!-- Invisible counterparts for consistent ViewBinding types in Landscape -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hdr_plus_pill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/tv_hdr_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/hdr_plus_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/top_right_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/flash_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lens_control_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/camera_switch_button_alt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lens_controls_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:strokeWidth="0dp"
            android:visibility="gone">
            <HorizontalScrollView android:id="@+id/controls_hub_scroll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:clipToPadding="false">
                <LinearLayout android:id="@+id/lens_controls_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="4dp" android:orientation="horizontal" />
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Manual Controls Panel in Landscape -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/manual_controls_root"
        style="@style/Widget.App.Card.ControlPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/radius_medium"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toStartOf="@id/bottom_island_card"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_small">

            <!-- Pro Info Bar -->
            <LinearLayout
                android:id="@+id/pro_info_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pill_focus"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:textSize="10sp"
                    android:text="AF"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pill_iso"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:textSize="10sp"
                    android:text="ISO AUTO"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pill_shutter"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:textSize="10sp"
                    android:text="SEC AUTO"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pill_ev"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:textSize="10sp"
                    android:text="EV 0.0"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- Dial Control Container -->
            <LinearLayout
                android:id="@+id/dial_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:id="@+id/tv_dial_target_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHUTTER"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="?attr/colorTertiary" />

                    <TextView
                        android:id="@+id/tv_dial_target_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:layout_marginStart="6dp"
                        android:text="1/125s"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dial_auto"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="6dp"
                        android:textSize="11sp"
                        android:text="AUTO" />
                </LinearLayout>

                <top.maary.darkbag.ui.ProDialWheelView
                    android:id="@+id/dial_wheel_view"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginVertical="2dp" />

                <LinearLayout
                    android:id="@+id/focus_extras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:paddingTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_focus_near"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:textSize="11sp"
                        android:text="Macro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_focus_far"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:textSize="11sp"
                        android:text="Infinity" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_island_card"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.google.android.material.button.MaterialButton android:id="@+id/lut_switcher_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <top.maary.darkbag.ui.ExpressiveShutterButton android:id="@+id/camera_capture_button" android:layout_width="@dimen/round_button_large" android:layout_height="@dimen/round_button_large" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="@dimen/margin_medium" />
            <ImageButton android:id="@+id/photo_view_button" android:layout_width="@dimen/round_button_medium" android:layout_height="@dimen/round_button_medium" app:layout_constraintBottom_toTopOf="@id/camera_capture_button" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="@dimen/margin_medium" android:layout_marginBottom="@dimen/margin_medium" android:background="@drawable/ic_outer_circle" app:srcCompat="@drawable/ic_photo" />
            <com.google.android.material.loadingindicator.LoadingIndicator android:id="@+id/processing_progress" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" app:layout_constraintTop_toTopOf="@id/photo_view_button" app:layout_constraintBottom_toBottomOf="@id/photo_view_button" app:layout_constraintStart_toStartOf="@id/photo_view_button" app:layout_constraintEnd_toEndOf="@id/photo_view_button" />
            <com.google.android.material.button.MaterialButton android:id="@+id/camera_switch_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lut_list_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/lut_list" android:layout_width="match_parent" android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

</merge>
