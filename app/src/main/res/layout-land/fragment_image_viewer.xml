<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/image_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Half-frame Selection Overlays (Used for dimming in edit mode) -->
    <View
        android:id="@+id/hf_selection_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#88000000"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toStartOf="@id/image_pager"
        app:layout_constraintEnd_toStartOf="@+id/hf_selection_divider" />

    <View
        android:id="@+id/hf_selection_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#88000000"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toEndOf="@+id/hf_selection_divider"
        app:layout_constraintEnd_toEndOf="@id/image_pager" />

    <View
        android:id="@+id/hf_selection_divider"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toStartOf="@id/image_pager"
        app:layout_constraintEnd_toEndOf="@id/image_pager" />

    <!-- Full-screen touch overlay for dismissing menus -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent" />

    <!-- Top Bar Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_navigation"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/margin_medium"
            app:icon="@drawable/ic_back"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialSplitButton
            android:id="@+id/split_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_main"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                app:icon="@drawable/ic_share"
                app:iconTint="?attr/colorOnSecondaryContainer" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_menu"
                style="?attr/materialSplitButtonIconFilledTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                app:icon="@drawable/m3_split_button_chevron_avd"
                app:iconTint="?attr/colorOnSecondaryContainer" />
        </com.google.android.material.button.MaterialSplitButton>

        <com.google.android.material.button.MaterialSplitButton
            android:id="@+id/split_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_medium"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_main"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                app:icon="@drawable/ic_save"
                app:iconTint="?attr/colorOnPrimary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_menu"
                style="?attr/materialSplitButtonIconFilledStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                app:icon="@drawable/m3_split_button_chevron_avd" />
        </com.google.android.material.button.MaterialSplitButton>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bottom_left_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:orientation="vertical"
        android:gravity="start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:id="@+id/hf_extra_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timestamp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:padding="0dp"
                app:icon="@drawable/ic_photo" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_flare"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="0dp"
                app:icon="@drawable/ic_hdr_dynamic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_swap_frames"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="0dp"
                app:icon="@drawable/ic_swap_horiz" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_log_lut"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:text="Log: None / LUT: None"
            android:textAllCaps="false"
            android:ellipsize="end"
            android:maxLines="1"
            app:icon="@drawable/ic_lut" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_right_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_adjust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Adjust"
            app:srcCompat="@drawable/ic_edit"
            style="@style/Widget.Material3.FloatingActionButton.Primary" />
    </LinearLayout>

    <!-- Integrated Adjustment Panel (Landscape: Right side) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_adjustment_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/adjustment_island"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/edit_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabMode="fixed"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.tabs.TabItem android:text="Light" />
                    <com.google.android.material.tabs.TabItem android:text="Range" />
                    <com.google.android.material.tabs.TabItem android:text="Tone" />
                    <com.google.android.material.tabs.TabItem android:text="Color" />
                </com.google.android.material.tabs.TabLayout>

                <ScrollView
                    android:id="@+id/edit_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    app:layout_constraintTop_toBottomOf="@id/edit_tabs"
                    app:layout_constraintBottom_toTopOf="@id/edit_actions">

                    <LinearLayout
                        android:id="@+id/slider_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/layout_slider_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tv_label_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Exposure"
                                    android:textAppearance="?attr/textAppearanceLabelLarge" />
                                <TextView
                                    android:id="@+id/tv_value_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.00"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorPrimary" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_slider_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tv_label_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Contrast"
                                    android:textAppearance="?attr/textAppearanceLabelLarge" />
                                <TextView
                                    android:id="@+id/tv_value_2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.00"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="?attr/colorPrimary" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/edit_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_cancel"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_done"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Done"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/group_frame_selection_integrated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:layout_constraintTop_toBottomOf="@id/btn_edit_cancel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_frame1_integrated"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F1" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_frame2_integrated"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F2" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/initial_loading_indicator"
        style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:elevation="10dp"
        app:indicatorSize="48dp"
        app:layout_constraintTop_toTopOf="@id/image_pager"
        app:layout_constraintBottom_toBottomOf="@id/image_pager"
        app:layout_constraintStart_toStartOf="@id/image_pager"
        app:layout_constraintEnd_toEndOf="@id/image_pager" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lut_list_container"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/radius_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_left_controls"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="400dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lut_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
