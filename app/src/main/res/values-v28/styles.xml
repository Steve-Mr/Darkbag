<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Edge-to-edge is handled in MainActivity.kt -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Fallbacks for Material3 attributes that might fail to resolve on some devices (Android 15+) -->
        <item name="colorSurfaceContainer">?attr/colorSurface</item>
        <item name="colorSurfaceContainerLow">?attr/colorSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurface</item>
        <item name="colorSurfaceContainerHighest">?attr/colorSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">?attr/colorSurface</item>

        <!-- Global fix for Material3 strokeColor resolution issue -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="shapeableImageViewStyle">@style/Widget.App.ShapeableImageView</item>

        <!-- Also override specific button styles that might bypass the generic materialButtonStyle -->
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="materialButtonTonalStyle">@style/Widget.App.Button.Tonal</item>
        <item name="materialButtonTextStyle">@style/Widget.App.Button.Text</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.App.ExtendedFloatingActionButton</item>
    </style>

</resources>
